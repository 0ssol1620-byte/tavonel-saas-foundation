{
  "framework": "nextjs",
  "regions": [
    "icn1"
  ],
  "env": {
    "COMMERCIAL_MODE": "live",
    "TAVONEL_BILLING_LAUNCH_APPROVED": "true",
    "ACCESS_MODE": "self_service"
  },
  "crons": [
    {
      "path": "/api/internal/jobs/run",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/internal/probe",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/internal/sli-alerts",
      "schedule": "1-56/5 * * * *"
    },
    {
      "path": "/api/internal/deletions/attest",
      "schedule": "3,18,33,48 * * * *"
    },
    {
      "path": "/api/internal/deletions/run",
      "schedule": "8,23,38,53 * * * *"
    }
  ],
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
