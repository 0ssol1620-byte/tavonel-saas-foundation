{
  "framework": "nextjs",
  "regions": ["icn1"],
  "env": {
    "COMMERCIAL_MODE": "live",
    "TAVONEL_BILLING_LAUNCH_APPROVED": "true",
    "ACCESS_MODE": "self_service"
  },
  "crons": [
    { "path": "/api/internal/jobs/run", "schedule": "* * * * *" },
    { "path": "/api/internal/probe", "schedule": "*/5 * * * *" }
  ],
  "headers": [{ "source": "/api/:path*", "headers": [{ "key": "Cache-Control", "value": "no-store" }] }]
}
